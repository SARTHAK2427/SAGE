# SAGE Environment Configuration Template
# Copy this file to .env and customize the paths for your local system.
# Do NOT commit real paths or secrets to version control.

# Path to the llama-server executable (optional if llama-server is in system PATH)
LLAMA_SERVER_PATH=C:\path\to\llama-server.exe

# Directory containing GGUF model files (gemma-4, qwen2.5-coder, Qwen3-VL, mmproj)
MODEL_DIR=C:\path\to\models

# One local home for all generated SAGE data. Defaults to ./data.
# SAGE_DATA_ROOT=C:\path\to\SAGE-data
# Optional granular overrides for a server/container/external drive:
# SAGE_ARTIFACTS_ROOT=C:\path\to\SAGE-data\documents\artifacts
# SAGE_DOCUMENT_CHROMA_ROOT=C:\path\to\SAGE-data\documents\chroma_bge_m3
# SAGE_MEMORY_CHROMA_ROOT=C:\path\to\SAGE-data\memory\chroma
# SAGE_SQLITE_PATH=C:\path\to\SAGE-data\memory\sage_memory.db

# BGE-M3 RAG is 1024-dimensional and uses a separate BGE index by default,
# preserving the old MiniLM index. CPU leaves the 8 GB Flash GPU for Gemma/Qwen.
SAGE_RAG_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
SAGE_RAG_EMBED_BATCH_SIZE=16
SAGE_RAG_CHUNK_TARGET_TOKENS=600
SAGE_RAG_CHUNK_OVERLAP_TOKENS=90
# Optional precision reranking. Disabled means no additional model is loaded.
SAGE_RERANKER_ENABLED=false
RERANKER_DEVICE=cpu
SAGE_RERANKER_CANDIDATE_K=20

# Mock inference for machines without llama-server / GGUF files.
# Keep at 0 when using real local or remote models.
SAGE_MOCK_MODE=0

# Canonical conversation/memory ledger (SQLite by default). The 2B curator's
# local-CPU or remote binding is selected ephemerally in the Flash Runtime UI.
SAGE_MEMORY_DB=sqlite
SAGE_MEMORY_CURATOR_ENABLED=1
SAGE_RECENT_CHAT_MAX_TURNS=5
SAGE_RECENT_CHAT_BUDGET_TOKENS=2400
SAGE_MEMORY_RECALL_LIMIT=6
SAGE_MEMORY_CURATOR_CHUNK_CHARS=12000

# Flash local ports. Remote endpoints and API keys are entered in the UI for
# the current runtime session and are never written to this file.
SAGE_FLASH_DEFAULT=1
SAGE_FLASH_GEMMA_PORT=8090
SAGE_FLASH_QWEN_PORT=8091
SAGE_FLASH_MEMORY_PORT=8092
SAGE_FLASH_MEMORY_CPU_THREADS=4
