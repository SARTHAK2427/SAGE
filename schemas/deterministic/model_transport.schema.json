{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sage.internal/schemas/deterministic/model_transport.schema.json",
  "title": "ModelTransportTelemetrySocket",
  "description": "Rich output socket for deterministic HTTP transport and inference telemetry from llama-server",
  "type": "object",
  "required": [
    "status",
    "operation",
    "result",
    "context",
    "execution",
    "timing",
    "warnings",
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "error"]
    },
    "operation": {
      "type": "string",
      "const": "model_http_transport"
    },
    "result": {
      "type": "object",
      "required": ["content", "tokens"],
      "properties": {
        "content": { "type": "string" },
        "tokens": {
          "type": "object",
          "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
          "properties": {
            "prompt_tokens": { "type": "integer", "minimum": 0 },
            "completion_tokens": { "type": "integer", "minimum": 0 },
            "total_tokens": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "finish_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["endpoint"],
      "properties": {
        "request_id": { "type": ["string", "null"] },
        "endpoint": { "type": "string" },
        "model_key": { "type": ["string", "null"] },
        "temperature": { "type": ["number", "null"] },
        "max_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "json_mode": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["http_status", "url", "telemetry"],
      "properties": {
        "http_status": { "type": "integer" },
        "url": { "type": "string" },
        "request_timestamp": { "type": "string", "format": "date-time" },
        "response_timestamp": { "type": "string", "format": "date-time" },
        "telemetry": {
          "type": "object",
          "properties": {
            "prompt_ms": { "type": ["number", "null"], "minimum": 0 },
            "completion_ms": { "type": ["number", "null"], "minimum": 0 },
            "prompt_per_second": { "type": ["number", "null"], "minimum": 0 },
            "completion_per_second": { "type": ["number", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "raw": {
      "description": "Raw llama-server JSON payload preserved verbatim. Intentionally permissive.",
      "oneOf": [
        { "type": "null" },
        { "type": "object" }
      ]
    },
    "timing": {
      "$ref": "common.schema.json#/$defs/Timing"
    },
    "warnings": {
      "$ref": "common.schema.json#/$defs/Warnings"
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "common.schema.json#/$defs/Error" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } } },
      "then": {
        "properties": {
          "error": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "error" } } },
      "then": {
        "properties": {
          "error": { "$ref": "common.schema.json#/$defs/Error" }
        }
      }
    }
  ]
}
