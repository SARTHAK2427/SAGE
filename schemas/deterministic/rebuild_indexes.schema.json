{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sage.internal/schemas/deterministic/rebuild_indexes.schema.json",
  "title": "RebuildAllIndexesSocket",
  "description": "Rich output socket for rebuilding all Chroma collections (sage_source and sage_derived) from all artifacts",
  "type": "object",
  "$defs": {
    "SourceSummary": {
      "type": "object",
      "properties": {
        "doc_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "total_source_records": { "type": "integer", "minimum": 0 },
        "documents": { "type": "integer", "minimum": 0 },
        "records": { "type": "integer", "minimum": 0 },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "DerivedSummary": {
      "type": "object",
      "properties": {
        "total_derived_records": { "type": "integer", "minimum": 0 },
        "images": { "type": "integer", "minimum": 0 },
        "records": { "type": "integer", "minimum": 0 },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "status",
    "operation",
    "result",
    "storage",
    "timing",
    "warnings",
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "partial", "error"]
    },
    "operation": {
      "type": "string",
      "const": "rebuild_all_indexes"
    },
    "result": {
      "type": "object",
      "properties": {
        "total_documents": { "type": "integer", "minimum": 0 },
        "total_records": { "type": "integer", "minimum": 0 },
        "source": { "$ref": "#/$defs/SourceSummary" },
        "derived": { "$ref": "#/$defs/DerivedSummary" }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": ["chroma_root", "artifacts_root", "artifacts_preserved"],
      "properties": {
        "chroma_root": { "type": "string" },
        "artifacts_root": { "type": "string" },
        "artifacts_preserved": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    },
    "timing": {
      "$ref": "common.schema.json#/$defs/Timing"
    },
    "warnings": {
      "$ref": "common.schema.json#/$defs/Warnings"
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "common.schema.json#/$defs/Error" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } } },
      "then": {
        "properties": {
          "error": { "type": "null" },
          "result": {
            "required": ["total_documents", "total_records", "source", "derived"]
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "error" } } },
      "then": {
        "properties": {
          "error": { "$ref": "common.schema.json#/$defs/Error" }
        }
      }
    }
  ]
}
