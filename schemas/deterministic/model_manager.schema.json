{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sage.internal/schemas/deterministic/model_manager.schema.json",
  "title": "ModelManagerLifecycleSocket",
  "description": "Rich output socket for llama-server lifecycle management and model swapping events",
  "type": "object",
  "required": [
    "status",
    "operation",
    "result",
    "identity",
    "context",
    "execution",
    "timing",
    "warnings",
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "error"]
    },
    "operation": {
      "type": "string",
      "const": "model_lifecycle"
    },
    "result": {
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "model_key": { "type": "string" },
        "model_name": { "type": "string" },
        "is_healthy": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["requested_model_key", "model_name"],
      "properties": {
        "requested_model_key": { "type": "string", "minLength": 1 },
        "model_name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "previous_model": { "type": ["string", "null"] },
        "current_model": { "type": ["string", "null"] },
        "switch_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["port", "host", "context_size", "gpu_layers"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "host": { "type": "string" },
        "context_size": { "type": "integer", "minimum": 1 },
        "gpu_layers": { "type": "integer", "minimum": 0 },
        "pid": { "type": ["integer", "null"], "minimum": 1 },
        "model_path": { "type": ["string", "null"] },
        "mmproj_path": { "type": ["string", "null"] },
        "log_file": { "type": ["string", "null"] },
        "visibility_mapping": {
          "$ref": "common.schema.json#/$defs/VisibilityMapping"
        }
      },
      "additionalProperties": false
    },
    "timing": {
      "$ref": "common.schema.json#/$defs/Timing"
    },
    "warnings": {
      "$ref": "common.schema.json#/$defs/Warnings"
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "common.schema.json#/$defs/Error" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } } },
      "then": {
        "properties": {
          "error": { "type": "null" },
          "result": {
            "required": ["action", "model_key", "model_name", "is_healthy"]
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "error" } } },
      "then": {
        "properties": {
          "error": { "$ref": "common.schema.json#/$defs/Error" }
        }
      }
    }
  ]
}
