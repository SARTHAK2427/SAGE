{
  "tools": [
    {
      "name": "document_database",
      "description": "Search and fetch information from registered uploaded documents.",
      "functions": [
        {
          "name": "rag_search",
          "description": "Semantic search over document knowledge. Returns multiple ranked matches; all are forwarded as evidence.",
          "arguments": {
            "query":   {"type": "string",  "required": true},
            "top_k":   {"type": "integer", "required": false},
            "doc_ids": {"type": "array",   "items": {"type": "string"}, "required": false}
          },
          "returns": {
            "type": "object",
            "description": "Multiple ranked matches in original retrieval order; all matches forwarded as evidence.",
            "properties": {
              "matches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {"type": "string"},
                    "doc_id": {"type": "string"},
                    "element_id": {"type": "string", "description": "Reusable in artifact_fetch"},
                    "element_type": {"type": "string"},
                    "raw_distance": {"type": "number"},
                    "cosine_similarity": {"type": "number"},
                    "source": {"type": "string", "enum": ["canonical", "derived"]},
                    "page": {"type": ["integer", "null"]},
                    "image_refs": {"type": "array", "items": {"type": "string"}, "description": "Reusable in vision_ocr/analyze_image"}
                  }
                }
              },
              "returned": {"type": "integer"},
              "top_k": {"type": "integer"}
            }
          }
        },
        {
          "name": "exact_search",
          "description": "Literal string, identifier, number, or regex search over canonical document text.",
          "arguments": {
            "query":          {"type": "string",  "required": true},
            "regex":          {"type": "boolean", "required": false},
            "case_sensitive": {"type": "boolean", "required": false},
            "doc_ids":        {"type": "array",   "items": {"type": "string"}, "required": false}
          },
          "returns": {
            "type": "object",
            "description": "Exact text matches with surrounding context and offsets.",
            "properties": {
              "matches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "doc_id": {"type": "string"},
                    "element_id": {"type": "string", "description": "Reusable in artifact_fetch"},
                    "element_type": {"type": "string"},
                    "matched_text": {"type": "string"},
                    "context": {"type": "string"},
                    "page": {"type": ["integer", "null"]},
                    "start_offset": {"type": "integer"},
                    "end_offset": {"type": "integer"},
                    "table_row": {"type": ["integer", "null"]},
                    "table_col": {"type": ["integer", "null"]}
                  }
                }
              }
            }
          }
        },
        {
          "name": "artifact_fetch",
          "description": "Fetch a specific known artifact (text, table, code, or image) by its element_id.",
          "arguments": {
            "doc_id":     {"type": "string", "required": true},
            "element_id": {"type": "string", "required": true}
          },
          "returns": {
            "type": "object",
            "description": "Typed artifact object based on element kind.",
            "properties": {
              "artifact": {
                "type": "object",
                "properties": {
                  "doc_id": {"type": "string"},
                  "element_id": {"type": "string"},
                  "type": {"type": "string", "enum": ["text", "table", "code", "image"]},
                  "page": {"type": ["integer", "null"]},
                  "text": {"type": "string", "description": "Present for text"},
                  "rows": {"type": "array", "description": "Present for table"},
                  "headers": {"type": "array", "description": "Optional for table"},
                  "markdown": {"type": "string", "description": "Optional for table"},
                  "code": {"type": "string", "description": "Present for code"},
                  "language": {"type": "string", "description": "Optional for code"},
                  "image_id": {"type": "string", "description": "Present for image; reusable in vision_ocr/analyze_image"},
                  "image_ref": {"type": "string", "description": "Optional registered reference"},
                  "caption": {"type": "string", "description": "Optional image caption"},
                  "derived_available": {"type": "boolean", "description": "True if cached vision analysis exists"}
                }
              }
            }
          }
        },
        {
          "name": "list_artifacts",
          "description": "List all artifacts in a document, optionally filtered by type. Useful for discovering images or tables not surfaced by RAG.",
          "arguments": {
            "doc_id": {"type": "string",            "required": true},
            "type":   {"type": ["string", "null"],  "required": false}
          },
          "returns": {
            "type": "object",
            "description": "Lightweight inventory of document artifacts.",
            "properties": {
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "element_id": {"type": "string", "description": "Reusable in artifact_fetch or vision_ocr/analyze_image"},
                    "type": {"type": "string"},
                    "order": {"type": "integer"},
                    "page": {"type": ["integer", "null"]},
                    "caption": {"type": ["string", "null"]},
                    "heading": {"type": ["string", "null"]},
                    "derived_available": {"type": ["boolean", "null"]}
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "vision_ocr",
      "description": "Read, transcribe, and analyze image content using a vision model.",
      "functions": [
        {
          "name": "analyze_image",
          "description": "Perform OCR, visual understanding, or combined OCR + analysis on a registered image.",
          "arguments": {
            "instruction": {"type": "string",           "required": true},
            "doc_id":      {"type": ["string", "null"], "required": false},
            "image_id":    {"type": "string",           "required": true},
            "image_ref":   {"type": ["string", "null"], "required": false}
          },
          "returns": {
            "type": "object",
            "description": "Vision analysis or OCR transcription produced by Qwen-VL.",
            "properties": {
              "doc_id": {"type": "string"},
              "image_id": {"type": "string"},
              "analysis": {"type": "string", "description": "Plain text analysis / OCR transcription"},
              "derived_analysis_id": {"type": "string", "description": "Optional cached analysis reference"}
            }
          }
        }
      ]
    },
    {
      "name": "code_specialist",
      "description": "Delegate all code generation, programming, script writing, algorithms, debugging, transformation, or refactoring to the coding specialist model (Qwen2.5-Coder). Gemma must never write or generate code directly itself.",
      "functions": [
        {
          "name": "solve_code_task",
          "description": "Generate, complete, fix, refactor, or translate code as described in the instruction.",
          "arguments": {
            "instruction": {"type": "string",           "required": true},
            "code":        {"type": ["string", "null"], "required": false},
            "language":    {"type": ["string", "null"], "required": false}
          },
          "returns": {
            "type": "object",
            "description": "Code specialist execution summary and code output.",
            "properties": {
              "code": {"type": "string", "description": "Generated or modified code"},
              "language": {"type": "string", "description": "Target language"},
              "execution_status": {"type": "string", "enum": ["success", "error", "not_executed"]},
              "stdout": {"type": "string", "description": "Standard output if executed"},
              "stderr": {"type": "string", "description": "Standard error if execution failed"},
              "exit_code": {"type": "integer", "description": "Process exit code if executed"},
              "attempts_used": {"type": "integer", "description": "Number of repair attempts used"}
            }
          }
        }
      ]
    },
    {
      "name": "math",
      "description": "Evaluate deterministic arithmetic and mathematical expressions.",
      "functions": [
        {
          "name": "calculate",
          "description": "Compute a mathematical expression and return the exact numeric result.",
          "arguments": {
            "expression": {"type": "string", "required": true}
          },
          "returns": {
            "type": "object",
            "description": "Deterministic arithmetic result.",
            "properties": {
              "expression": {"type": "string"},
              "value": {"type": ["number", "null"], "description": "Exact evaluated numeric result"}
            }
          }
        }
      ]
    },
    {
      "name": "general_knowledge",
      "description": "General knowledge and conceptual question answering specialist. Powered by Qwen3.5. Delegate any factual, general, conceptual, definitions, or world knowledge queries here.",
      "functions": [
        {
          "name": "answer_query",
          "description": "Answer a general factual, conceptual, conversational, or educational query.",
          "arguments": {
            "query": {"type": "string", "required": true, "description": "The question or topic to explain."}
          },
          "returns": {
            "type": "object",
            "description": "Direct knowledge answer from specialist.",
            "properties": {
              "answer": {"type": "string", "description": "Factual and concise answer to the query."}
            }
          }
        }
      ]
    },
    {
      "name": "durable_memory",
      "description": "Search and retrieve stored durable user facts, preferences, project details, decisions, and instructions across conversations.",
      "functions": [
        {
          "name": "memory_search",
          "description": "Search active durable memories filtered by category.",
          "arguments": {
            "query":    {"type": ["string", "null"], "required": false},
            "category": {"type": ["string", "null"], "required": false, "enum": ["fact", "preference", "project", "decision", "instruction"]},
            "limit":    {"type": "integer",          "required": false}
          },
          "returns": {
            "type": "object",
            "description": "Filtered active durable memories.",
            "properties": {
              "memories": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "memory_id": {"type": "string"},
                    "content": {"type": "string"},
                    "category": {"type": "string"},
                    "importance": {"type": "number"},
                    "confidence": {"type": "number"},
                    "source_chat_id": {"type": ["string", "null"]},
                    "created_at": {"type": "string"},
                    "updated_at": {"type": "string"}
                  }
                }
              },
              "returned": {"type": "integer"}
            }
          }
        },
        {
          "name": "memory_get",
          "description": "Retrieve a specific active durable memory by its memory_id.",
          "arguments": {
            "memory_id": {"type": "string", "required": true}
          },
          "returns": {
            "type": "object",
            "description": "Retrieved memory object or null.",
            "properties": {
              "memory": {"type": ["object", "null"]}
            }
          }
        },
        {
          "name": "memory_store",
          "description": "Store a durable fact, preference, project detail, decision, or instruction that should persist across conversations, or supersede/replace an existing obsolete memory.",
          "arguments": {
            "content":              {"type": "string",  "required": true,  "description": "The fact, preference, decision, or instruction to store."},
            "category":             {"type": "string",  "required": true,  "enum": ["fact", "preference", "project", "decision", "instruction"]},
            "importance":           {"type": "number",  "required": false, "description": "Subjective importance score between 0.0 and 1.0 (default 0.5)"},
            "confidence":           {"type": "number",  "required": false, "description": "Confidence score between 0.0 and 1.0 (default 1.0)"},
            "supersedes_memory_id": {"type": ["string", "null"], "required": false, "description": "Optional memory_id of an existing active memory that this new statement replaces or supersedes."}
          },
          "returns": {
            "type": "object",
            "description": "Stored durable memory record.",
            "properties": {
              "memory": {
                "type": "object",
                "properties": {
                  "memory_id": {"type": "string"},
                  "content": {"type": "string"},
                  "category": {"type": "string"},
                  "importance": {"type": "number"},
                  "confidence": {"type": "number"},
                  "status": {"type": "string"},
                  "supersedes_memory_id": {"type": ["string", "null"]}
                }
              }
            }
          }
        },
        {
          "name": "memory_search_hot",
          "description": "Search active session-scoped hot memories for the current conversation and task context.",
          "arguments": {
            "query":    {"type": ["string", "null"], "required": false, "description": "Semantic query describing the current task context to retrieve."},
            "category": {"type": ["string", "null"], "required": false, "enum": ["fact", "preference", "project", "decision", "instruction"]},
            "limit":    {"type": "integer",          "required": false, "description": "Max results to return (1-20, default 5)."}
          },
          "returns": {
            "type": "object",
            "description": "Filtered active hot memories for the current session.",
            "properties": {
              "memories": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "memory_id": {"type": "string"},
                    "content": {"type": "string"},
                    "category": {"type": "string"},
                    "importance": {"type": "number"},
                    "confidence": {"type": "number"},
                    "memory_tier": {"type": "string"},
                    "source_chat_id": {"type": ["string", "null"]},
                    "created_at": {"type": "string"},
                    "updated_at": {"type": "string"}
                  }
                }
              },
              "returned": {"type": "integer"}
            }
          }
        },
        {
          "name": "memory_search_cold",
          "description": "Search active durable cold memories for the user across all conversations.",
          "arguments": {
            "query":    {"type": ["string", "null"], "required": false, "description": "Semantic query describing durable preferences or facts to retrieve."},
            "category": {"type": ["string", "null"], "required": false, "enum": ["fact", "preference", "project", "decision", "instruction"]},
            "limit":    {"type": "integer",          "required": false, "description": "Max results to return (1-20, default 5)."}
          },
          "returns": {
            "type": "object",
            "description": "Filtered active durable cold memories.",
            "properties": {
              "memories": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "memory_id": {"type": "string"},
                    "content": {"type": "string"},
                    "category": {"type": "string"},
                    "importance": {"type": "number"},
                    "confidence": {"type": "number"},
                    "memory_tier": {"type": "string"},
                    "source_chat_id": {"type": ["string", "null"]},
                    "created_at": {"type": "string"},
                    "updated_at": {"type": "string"}
                  }
                }
              },
              "returned": {"type": "integer"}
            }
          }
        },
        {
          "name": "memory_store_hot",
          "description": "Store a temporary, session-scoped hot memory for the current conversation and task context.",
          "arguments": {
            "content":    {"type": "string",  "required": true,  "description": "The contextual or temporary task fact to store."},
            "category":   {"type": "string",  "required": true,  "enum": ["fact", "preference", "project", "decision", "instruction"]},
            "importance": {"type": "number",  "required": false, "description": "Subjective importance score between 0.0 and 1.0 (default 0.5)"},
            "confidence": {"type": "number",  "required": false, "description": "Confidence score between 0.0 and 1.0 (default 1.0)"}
          },
          "returns": {
            "type": "object",
            "description": "Stored hot memory record.",
            "properties": {
              "memory": {
                "type": "object",
                "properties": {
                  "memory_id": {"type": "string"},
                  "content": {"type": "string"},
                  "category": {"type": "string"},
                  "importance": {"type": "number"},
                  "confidence": {"type": "number"},
                  "status": {"type": "string"},
                  "memory_tier": {"type": "string"}
                }
              }
            }
          }
        },
        {
          "name": "memory_store_cold",
          "description": "Store a durable cold memory fact, preference, project detail, decision, or instruction that persists across conversations.",
          "arguments": {
            "content":              {"type": "string",  "required": true,  "description": "The durable fact or preference to store."},
            "category":             {"type": "string",  "required": true,  "enum": ["fact", "preference", "project", "decision", "instruction"]},
            "importance":           {"type": "number",  "required": false, "description": "Subjective importance score between 0.0 and 1.0 (default 0.5)"},
            "confidence":           {"type": "number",  "required": false, "description": "Confidence score between 0.0 and 1.0 (default 1.0)"},
            "supersedes_memory_id": {"type": ["string", "null"], "required": false, "description": "Optional memory_id of an existing active cold memory that this replaces."}
          },
          "returns": {
            "type": "object",
            "description": "Stored cold memory record.",
            "properties": {
              "memory": {
                "type": "object",
                "properties": {
                  "memory_id": {"type": "string"},
                  "content": {"type": "string"},
                  "category": {"type": "string"},
                  "importance": {"type": "number"},
                  "confidence": {"type": "number"},
                  "status": {"type": "string"},
                  "memory_tier": {"type": "string"},
                  "supersedes_memory_id": {"type": ["string", "null"]}
                }
              }
            }
          }
        },
        {
          "name": "memory_promote",
          "description": "Promote a session-scoped hot memory to a durable cold memory if it represents long-term user context.",
          "arguments": {
            "memory_id": {"type": "string", "required": true, "description": "The memory_id of the active hot memory to promote."}
          },
          "returns": {
            "type": "object",
            "description": "Promoted durable cold memory record.",
            "properties": {
              "memory": {
                "type": "object",
                "properties": {
                  "memory_id": {"type": "string"},
                  "content": {"type": "string"},
                  "category": {"type": "string"},
                  "importance": {"type": "number"},
                  "confidence": {"type": "number"},
                  "status": {"type": "string"},
                  "memory_tier": {"type": "string"}
                }
              }
            }
          }
        },
        {
          "name": "memory_summarize",
          "description": "Compact multiple related active hot memories from the current session into a single concise hot summary memory.",
          "arguments": {
            "memory_ids":       {"type": "array", "items": {"type": "string"}, "required": true, "description": "List of active hot memory IDs to compact."},
            "summary_content":  {"type": "string", "required": true, "description": "Concise factual summary combining the source hot memories."},
            "category":         {"type": "string", "required": false, "enum": ["fact", "preference", "project", "decision", "instruction"], "description": "Category for the summary memory (default 'fact')."},
            "importance":       {"type": "number", "required": false, "description": "Importance score between 0.0 and 1.0 (default 0.5)."},
            "confidence":       {"type": "number", "required": false, "description": "Confidence score between 0.0 and 1.0 (default 1.0)."}
          },
          "returns": {
            "type": "object",
            "description": "Resulting active hot summary memory record.",
            "properties": {
              "memory": {
                "type": "object",
                "properties": {
                  "memory_id": {"type": "string"},
                  "content": {"type": "string"},
                  "category": {"type": "string"},
                  "importance": {"type": "number"},
                  "confidence": {"type": "number"},
                  "status": {"type": "string"},
                  "memory_tier": {"type": "string"}
                }
              }
            }
          }
        }
      ]
    }
  ]
}